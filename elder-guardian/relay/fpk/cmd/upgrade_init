#!/bin/bash
# 升级前：停服务，并把配置与状态备份一份，防止新版本改坏数据
set -u

CMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKGVAR="${TRIM_PKGVAR:-/var/apps/elderrelay/var}"

"${CMD_DIR}/main" stop >/dev/null 2>&1 || true

if [ -d "${PKGVAR}" ]; then
  STAMP="$(date '+%Y%m%d%H%M%S')"
  mkdir -p "${PKGVAR}/backup" 2>/dev/null || true
  tar -czf "${PKGVAR}/backup/pre-upgrade-${STAMP}.tar.gz" \
    -C "${PKGVAR}" config.json state.json 2>/dev/null || true
  # 只保留最近 5 份备份
  ls -1t "${PKGVAR}/backup"/pre-upgrade-*.tar.gz 2>/dev/null \
    | tail -n +6 | while read -r f; do rm -f "$f"; done
fi

exit 0
